#!/usr/bin/env bash
# Start MyriadCode and open it in the browser.
#
# Installed as a symlink on PATH, so this resolves the link to find the repo
# rather than assuming where it was called from.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"

PORT="${PORT:-8219}"
HOST="${HOST:-127.0.0.1}"
URL="http://${HOST}:${PORT}"

open_browser() {
  # Wait for the port before opening, or the tab lands on a connection error.
  for _ in $(seq 1 60); do
    if curl -sf -o /dev/null --max-time 1 "$URL/"; then
      command -v xdg-open >/dev/null 2>&1 && xdg-open "$URL" >/dev/null 2>&1 &
      return
    fi
    sleep 0.25
  done
  echo "myriadcode: server did not come up at $URL" >&2
}

# -sTCP:LISTEN is essential: without it lsof also lists every client connected
# to the port, so with the page open in a browser this returned the browser's
# pid. stop then killed the browser and reported that the server would not die.
# Always succeeds, because lsof exits non-zero when nothing matches and `set -e`
# would otherwise abort before anything could be reported.
running_pid() { lsof -ti:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true; }

UNIT="myriadcode.service"
UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"

# Installed, not merely running. Once the unit exists it owns the port, and a
# CLI that only checked `is-active` would answer `restart` on a stopped service
# by exec'ing a second server in the terminal -- which then holds the port the
# service needs, so the service can never come back. Installed means every
# start, stop and restart goes through systemd.
service_installed() {
  [ -f "$UNIT_PATH" ] && command -v systemctl >/dev/null 2>&1
}

service_active() {
  service_installed && systemctl --user is-active --quiet "$UNIT" 2>/dev/null
}

# `Restart=always` means killing the pid is not stopping the server: systemd
# just brings it back two seconds later, which reads as "stop did nothing".
# Anything that takes the server down has to go through systemd when systemd is
# the one holding it up.
install_service() {
  command -v systemctl >/dev/null 2>&1 || {
    echo "myriadcode: no systemctl on this machine" >&2; return 1; }
  mkdir -p "$(dirname "$UNIT_PATH")"
  cat > "$UNIT_PATH" <<EOF
[Unit]
Description=MyriadCode
Documentation=https://github.com/Tristan367/MyriadCode
After=network-online.target
# Without a start limit, a server already holding the port turns Restart into an
# infinite loop -- and every attempt loads the whisper model onto the GPU before
# failing to bind, so the flap costs 700MB and three seconds of CPU each time.
# Five tries in two minutes, then stop and stay stopped for someone to look at.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=$ROOT
# .env is read by load_dotenv() from the working directory, so there is no
# EnvironmentFile here on purpose -- one loader, one place to look.
ExecStart=$ROOT/.venv/bin/python -m uvicorn agent_server.main:app --host $HOST --port $PORT
# on-failure, not always: a clean exit is someone stopping it deliberately.
Restart=on-failure
RestartSec=3
# SIGTERM and time to use it: uvicorn's shutdown hook checkpoints the WAL, and
# a SIGKILL part-way through that is how a database ends up needing recovery.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  # Started, not enabled. The unit is here so the server outlives the terminal
  # it was launched from and comes back if it crashes -- not so that it is
  # already running before anyone has asked for it. A machine that boots
  # straight into a loaded whisper model, an open database and a server holding
  # the port is one where `myriadcode` answers "already running" to somebody who
  # has only just sat down, which reads as the app having done something behind
  # their back. Opt into login start with `myriadcode service autostart on`.
  systemctl --user start "$UNIT"
  echo "myriadcode: installed $UNIT_PATH"
  echo "           running now and restarts on failure; $URL"
  echo "           it does NOT start at login -- 'myriadcode service autostart on' if you want that"
  echo "           logs: journalctl --user -u $UNIT -f"
}

set_autostart() {
  command -v systemctl >/dev/null 2>&1 || {
    echo "myriadcode: no systemctl on this machine" >&2; return 1; }
  service_installed || {
    echo "myriadcode: no service installed. Run: myriadcode service install" >&2; return 1; }
  case "$1" in
    on)
      systemctl --user enable "$UNIT"
      echo "myriadcode: will start at login"
      ;;
    off)
      # disable, not `disable --now`: turning off the login start is not a
      # request to take down the server you are presently using.
      systemctl --user disable "$UNIT"
      echo "myriadcode: will not start at login (still running now, if it was)"
      ;;
    *) echo "usage: myriadcode service autostart on|off" >&2; return 2 ;;
  esac
}

uninstall_service() {
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user disable --now "$UNIT" 2>/dev/null || true
  rm -f "$UNIT_PATH"
  systemctl --user daemon-reload
  echo "myriadcode: removed $UNIT_PATH"
}

stop_server() {
  if service_installed; then
    systemctl --user stop "$UNIT"
    echo "myriadcode: stopped (systemd service)"
    return 0
  fi
  local pid
  pid="$(running_pid)"
  [ -n "$pid" ] || { echo "myriadcode: not running"; return 1; }
  # SIGTERM, not -9, so uvicorn's shutdown hook runs and the server stops cleanly.
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 40); do
    sleep 0.25
    [ -n "$(running_pid)" ] || { echo "myriadcode: stopped"; return 0; }
  done
  echo "myriadcode: did not stop; sending SIGKILL" >&2
  kill -9 "$pid" 2>/dev/null || true
  return 0
}

case "${1:-}" in
  stop)
    stop_server || true
    exit 0
    ;;
  restart)
    if service_installed; then
      systemctl --user restart "$UNIT"
      echo "myriadcode: restarted (systemd service)"
      exit 0
    fi
    stop_server || true
    sleep 0.5
    ;;
  service)
    case "${2:-}" in
      install)   install_service; exit $? ;;
      uninstall) uninstall_service; exit 0 ;;
      autostart) set_autostart "${3:-}"; exit $? ;;
      *) echo "usage: myriadcode service install|uninstall|autostart on|off" >&2; exit 2 ;;
    esac
    ;;
  status)
    pid="$(running_pid)"
    if [ -n "$pid" ]; then
      echo "myriadcode: running at $URL (pid $pid)"
      service_active && echo "           managed by systemd ($UNIT)"
    else
      echo "myriadcode: not running"
      service_installed && echo "           installed as $UNIT; start it with 'myriadcode'"
    fi
    exit 0
    ;;
  open)
    open_browser
    exit 0
    ;;
  -h|--help)
    cat <<'EOF'
myriadcode            start the server and open it in your browser
myriadcode stop       stop it cleanly
myriadcode restart    stop it, then start in this terminal
myriadcode status     is it running, and on what pid
myriadcode open       just open the browser at a server already running
myriadcode --no-open  start without opening a browser

myriadcode service install    run it as a systemd user service: survives
                              closing the terminal it was started from and
                              restarts on failure. It does not start at login.
myriadcode service uninstall  remove that again
myriadcode service autostart on|off
                              whether the service also starts at login (off
                              after a fresh install)

Ctrl-C stops a server started in this terminal. Use `myriadcode stop` for one
started somewhere else. Both let the server shut down cleanly; kill -9 does not.
EOF
    exit 0
    ;;
esac

[ -d .venv ] || { echo "myriadcode: no .venv. Run: uv venv && uv pip install -r requirements.txt" >&2; exit 1; }

# Already running? Just show it, rather than killing someone's in-flight turn.
if curl -sf -o /dev/null --max-time 1 "$URL/"; then
  echo "myriadcode: already running at $URL (pid $(running_pid))"
  echo "           opening it. Use 'myriadcode stop' or 'myriadcode restart' to take it down."
  [ "${1:-}" = "--no-open" ] || open_browser
  exit 0
fi

# With the service installed, starting means starting the service -- never a
# second server in this terminal, which would take the port the service needs
# and die with the terminal, which is the whole thing the service exists to fix.
if service_installed; then
  systemctl --user start "$UNIT"
  echo "myriadcode: started (systemd service) at $URL"
  [ "${1:-}" = "--no-open" ] || open_browser
  exit 0
fi

[ "${1:-}" = "--no-open" ] || open_browser &

echo "myriadcode: starting at $URL  (Ctrl-C to stop)"
# exec, so Ctrl-C reaches uvicorn directly and its shutdown hook runs.
exec .venv/bin/python -m uvicorn agent_server.main:app --host "$HOST" --port "$PORT"
